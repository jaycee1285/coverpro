{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "clipboard-manager:default",
    "dialog:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.anthropic.com/*"
        },
        {
          "url": "https://api.openai.com/*"
        },
        {
          "url": "https://openrouter.ai/*"
        },
        {
          "url": "https://httpbin.org/*"
        }
      ]
    }
  ]
}
